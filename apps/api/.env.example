# ── Supabase (Project Settings → Database → Connection string) ──
# Ứng dụng: connection pooler, transaction mode (cổng 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migration / Prisma Studio: kết nối trực tiếp (cổng 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# (Tùy chọn) DB trống dùng làm shadow database cho `prisma migrate dev`
SHADOW_DATABASE_URL=""

# ── Supabase Auth ──
SUPABASE_URL="https://<project-ref>.supabase.co"
# Chỉ dùng ở backend. KHÔNG đưa vào app mobile / admin phía trình duyệt.
SUPABASE_SERVICE_ROLE_KEY=""

# ── API ──
PORT=3000
NODE_ENV=development

# Job cập nhật tỷ giá hằng ngày (ExchangeRate-API, dự phòng fawazahmed0/currency-api)
FX_SYNC_ENABLED=true

# Redis cho hàng đợi BullMQ (dev: docker compose up -d ở thư mục gốc)
REDIS_URL=redis://localhost:6379
REMINDERS_ENABLED=true
# Tùy chọn, chỉ cần khi bật Enhanced Push Security trên Expo
EXPO_ACCESS_TOKEN=

# Origin của Admin Console được phép gọi API từ trình duyệt (cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101
# Bắt buộc admin đăng nhập qua xác thực hai bước (bật khi lên production)
ADMIN_REQUIRE_MFA=false

# ── Tự động phát hiện subscription từ Gmail ──
# URL công khai của API (redirect URI OAuth sẽ là <PUBLIC_API_URL>/connections/gmail/callback)
PUBLIC_API_URL=http://localhost:3000
# OAuth client của Google Cloud (loại Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Khóa mã hóa refresh token: sinh bằng `openssl rand -base64 32`
SECRETS_KEY=
# Tắt lượt quét hộp thư định kỳ
EMAIL_SYNC_ENABLED=true
