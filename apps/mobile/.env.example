# Sao thành .env.local (không commit). Biến EXPO_PUBLIC_* được nhúng vào bundle — chỉ để giá trị công khai.
# URL project Supabase (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://lvnjhgmjmgxonbmsvtag.supabase.co
# Publishable key / anon key (công khai được; KHÔNG dùng service_role key ở đây)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# API NestJS. Simulator iOS: localhost; máy Android ảo: http://10.0.2.2:3000; máy thật: IP LAN của máy dev
EXPO_PUBLIC_API_URL=http://localhost:3000
